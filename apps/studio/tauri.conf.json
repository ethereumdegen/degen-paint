{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "degen-paint",
  "version": "0.1.0",
  "identifier": "dev.degenpaint.studio",
  "build": {
    "frontendDist": "../../crates/dpaint-studio/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Agent-native image and 3D asset studio",
    "longDescription": "degen-paint Studio: one document, one journal and one undo stack shared by a human and an agent.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
